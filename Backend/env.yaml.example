# Backend/env.yaml.example
GCP_PROJECT_ID: "your-project-id"
GCP_BUCKET_NAME: "your-bucket-name"
PUBSUB_TOPIC: "video-processing"
FIRESTORE_DATABASE: "(default)"
MAX_VIDEO_SIZE_MB: "2048"
ALLOWED_VIDEO_TYPES: "video/mp4,video/quicktime,video/avi"
GCP_SERVICE_ACCOUNT_EMAIL: "your-service-account@your-project.iam.gserviceaccount.com"
ALLOWED_ORIGINS: "http://localhost:5173,https://your-app.web.app"